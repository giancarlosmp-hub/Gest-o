[Unit]
Description=Demetra CRM
After=docker.service

[Service]
WorkingDirectory=/apps/gest-o
Environment=PRODUCTION_ENV_FILE=/root/demetra-env/production.env
ExecStart=/bin/bash -lc 'set -a; . "$PRODUCTION_ENV_FILE"; set +a; export APP_COMMIT=$(git rev-parse HEAD) APP_BUILT_AT=systemd APP_VERSION=$(node -p "require(\"./package.json\").version"); export API_IMAGE="gest-o-api:$APP_COMMIT" WEB_IMAGE="gest-o-web:$APP_COMMIT"; exec /usr/bin/docker compose --env-file "$PRODUCTION_ENV_FILE" -f docker-compose.production.yml up -d --no-build --no-deps api web'
ExecStop=/usr/bin/docker compose --env-file /root/demetra-env/production.env -f docker-compose.production.yml stop api web
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
