{
  "name": "@salesforce-pro/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @salesforce-pro/shared && tsc -p tsconfig.json --noEmit && vite build && node ./scripts/verify-brand-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:responsive": "node ./scripts/verify-mobile-layout.mjs",
    "test:opportunity-quick-action": "npx tsx tests/opportunityQuickAction.test.ts",
    "test:orders": "npx tsx tests/orderPresentation.test.ts",
    "test:client-code-erp-only": "npx tsx tests/clientCodeErpOnly.test.ts",
    "test:client-archive-status": "npx tsx tests/clientArchiveStatus.test.ts",
    "test:client-address-label": "npx tsx tests/clientAddressLabel.test.ts",
    "test:crm-assistant-evidence": "npx tsx tests/crmAssistantEvidence.test.ts",
    "test:client-list-filters": "npx tsx tests/clientListFilters.test.ts",
    "test:client-select-search": "npx tsx tests/clientSelectSearch.test.ts",
    "test:brazil-date": "npx tsx tests/brazilDate.test.ts",
    "test:mobile-visit-action": "npx tsx tests/mobileVisitAction.test.ts",
    "test:visit-draft": "npx tsx tests/visitDraft.test.ts",
    "test:agenda-activity": "npx tsx tests/agendaActivity.test.ts",
    "test:route-execution": "npx tsx tests/routeExecution.test.ts",
    "test:central-day-agenda": "npx tsx tests/centralDayAgenda.test.ts",
    "test:seller-central": "npx tsx tests/sellerDayList.test.ts && npx tsx tests/sellerCentralLayout.test.ts",
    "test:seller-week":"npx tsx tests/sellerWeek.test.ts && npx tsx tests/sellerDashboardLayout.test.ts",
    "test:erp-payment-method-eligibility": "npx tsx tests/erpPaymentMethodEligibility.test.ts",
    "test:whatsapp-link": "npx tsx tests/whatsappLink.test.ts",
    "test:desktop-layout": "node ./scripts/verify-desktop-layout.mjs"
  },
  "dependencies": {
    "@salesforce-pro/shared": "1.0.0",
    "axios": "^1.6.8",
    "chart.js": "^4.4.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
