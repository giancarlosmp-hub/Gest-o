generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  diretor
  gerente
  vendedor
}

enum TenantStatus {
  active
  suspended
  archived
}

enum TenantMembershipStatus {
  invited
  active
  revoked
}

enum TenantRole {
  diretor
  gerente
  vendedor
}

enum OpportunityStage {
  prospeccao
  negociacao
  proposta
  ganho
  perdido
}

enum ActivityType {
  ligacao
  whatsapp
  visita
  reuniao
  followup
  proposta_enviada
  proposta_negociacao
  fechamento
  envio_proposta
  visita_tecnica
  cliente_novo
  follow_up
}

enum EventType {
  comentario
  mudanca_etapa
  status
}

enum ClientType {
  PJ
  PF
}

enum AgendaEventType {
  reuniao_online
  reuniao_presencial
  roteiro_visita
  followup
}

enum AgendaEventStatus {
  agendado
  realizado
  vencido
}

enum OpportunityItemDiscountType {
  value
  percent
}

model User {
  id                         String                      @id @default(cuid())
  name                       String
  email                      String                      @unique
  passwordHash               String
  role                       Role
  region                     String?
  erpCode                    String?
  erpOperatorCode            String?
  erpRawPayload              Json?
  erpLoginUsername           String?
  erpLoginPasswordEncrypted  String?
  erpLoginLastTestStatus     String?
  erpLoginLastTestAt         DateTime?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  clients                    Client[]
  contacts                   Contact[]
  opportunities              Opportunity[]
  erpOrderSyncs              ErpOrderSync[]
  erpOrderManualResolutions  ErpOrderManualResolution[]
  opportunityChangeLogs      OpportunityChangeLog[]
  activities                 Activity[]
  timelineEvents             TimelineEvent[]
  communicationConversations CommunicationConversation[]
  goals                      Goal[]
  activityKpis               ActivityKPI[]
  sales                      Sale[]
  agendaEvents               AgendaEvent[]
  territoryCities            SellerTerritoryCity[]
  knowledgeDocuments         KnowledgeDocument[]
  tenantMemberships          TenantMembership[]
}

model Tenant {
  id          String             @id
  slug        String             @unique
  legalName   String
  displayName String
  status      TenantStatus       @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  suspendedAt DateTime?
  memberships TenantMembership[]

  // Business roots introduced as nullable ownership during Sprint 1.0B.2-A expand.
  clients            Client[]              @relation("TenantClients")
  agendaEvents       AgendaEvent[]         @relation("TenantAgendaEvents")
  products           Product[]             @relation("TenantProducts")
  appConfigs         AppConfig[]           @relation("TenantAppConfigs")
  goals              Goal[]                @relation("TenantGoals")
  activityKpis       ActivityKPI[]         @relation("TenantActivityKpis")
  sales              Sale[]                @relation("TenantSales")
  territoryCities    SellerTerritoryCity[] @relation("TenantTerritoryCities")
  knowledgeDocuments KnowledgeDocument[]   @relation("TenantKnowledgeDocuments")
  erpSyncRuns        ErpSyncRun[]          @relation("TenantErpSyncRuns")
  erpSyncLocks       ErpSyncLock[]         @relation("TenantErpSyncLocks")
  erpOrders          ErpOrderSync[]        @relation("TenantErpOrders")
}

model TenantMembership {
  id         String                 @id
  tenantId   String
  userId     String
  role       TenantRole
  status     TenantMembershipStatus
  version    Int
  invitedAt  DateTime?
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model KnowledgeDocument {
  tenantId    String?
  tenant      Tenant?  @relation("TenantKnowledgeDocuments", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String   @id @default(cuid())
  title       String
  category    String
  sourceType  String
  sourceName  String?
  content     String
  summary     String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sourceType])
  @@index([isActive])
  @@index([createdById])
  @@index([tenantId])
}

model Client {
  tenantId                   String?
  tenant                     Tenant?                     @relation("TenantClients", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                         String                      @id @default(cuid())
  code                       String?
  fantasyName                String?
  name                       String
  nameNormalized             String?                     @db.VarChar(255)
  city                       String
  cityNormalized             String?                     @db.VarChar(255)
  state                      String
  region                     String
  potentialHa                Float?                      @default(0)
  farmSizeHa                 Float?                      @default(0)
  clientType                 ClientType                  @default(PJ)
  cnpj                       String?
  cnpjNormalized             String?                     @db.VarChar(32)
  segment                    String?
  lastPurchaseDate           DateTime?
  lastPurchaseValue          Float?
  erpUpdatedAt               DateTime?
  isArchived                 Boolean                     @default(false)
  archiveReason              String?
  financialProfile           Json?
  partnerTitles              Json?
  openTitlesTotal            Float?                      @default(0)
  overdueTitlesTotal         Float?                      @default(0)
  ownerSellerId              String
  ownerSeller                User                        @relation(fields: [ownerSellerId], references: [id])
  contacts                   Contact[]
  opportunities              Opportunity[]
  timelineEvents             TimelineEvent[]
  communicationConversations CommunicationConversation[]
  createdAt                  DateTime                    @default(now())
  agendaEvents               AgendaEvent[]
  agendaStops                AgendaStop[]
  activities                 Activity[]
  codeAuditEvents            ClientCodeAudit[]

  @@index([code])
  @@index([fantasyName])
  @@index([isArchived])
  @@index([tenantId])
}

model ClientCodeAudit {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  partnerErp  String?
  oldValue    String?
  newValue    String?
  origin      String
  actorUserId String?
  actorEmail  String?
  requestIp   String?
  requestId   String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([requestId])
  @@index([origin, createdAt])
}

model AgendaEvent {
  tenantId      String?
  tenant        Tenant?           @relation("TenantAgendaEvents", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String            @id @default(cuid())
  title         String
  type          AgendaEventType
  startDateTime DateTime
  endDateTime   DateTime
  status        AgendaEventStatus @default(agendado)
  notes         String?
  city          String?
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id])
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id])
  sellerId      String
  seller        User              @relation(fields: [sellerId], references: [id])
  stops         AgendaStop[]
  activities    Activity[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([sellerId, startDateTime])
  @@index([startDateTime, endDateTime])
  @@index([opportunityId])
  @@index([tenantId])
}

model AgendaStop {
  id               String      @id @default(cuid())
  agendaEventId    String
  agendaEvent      AgendaEvent @relation(fields: [agendaEventId], references: [id], onDelete: Cascade)
  order            Int
  clientId         String?
  client           Client?     @relation(fields: [clientId], references: [id])
  city             String?
  address          String?
  plannedTime      DateTime?
  notes            String?
  checkInAt        DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  resultStatus     String?
  resultReason     String?
  resultSummary    String?
  nextStep         String?
  nextStepDate     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([agendaEventId, order])
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  phone           String
  phoneNormalized String?  @db.VarChar(32)
  phoneHash       String?  @db.VarChar(64)
  email           String
  role            String?
  department      String?
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  isPrimary       Boolean  @default(false)
  notes           String?
  ownerSellerId   String
  ownerSeller     User     @relation(fields: [ownerSellerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phoneHash])
  @@index([ownerSellerId, phoneHash])
}

model Opportunity {
  id                   String                 @id @default(cuid())
  title                String
  value                Float
  stage                OpportunityStage
  crop                 String?
  season               String?
  areaHa               Float?
  productOffered       String?
  plantingForecastDate DateTime?
  expectedTicketPerHa  Float?
  proposalDate         DateTime
  followUpDate         DateTime
  expectedCloseDate    DateTime
  closedAt             DateTime?
  lastContactAt        DateTime?
  probability          Int?
  notes                String?
  priceTableCode       String?                @default("1")
  clientId             String
  client               Client                 @relation(fields: [clientId], references: [id])
  ownerSellerId        String
  ownerSeller          User                   @relation(fields: [ownerSellerId], references: [id])
  activities           Activity[]
  agendaEvents         AgendaEvent[]
  timelineEvents       TimelineEvent[]
  changeLogs           OpportunityChangeLog[]
  items                OpportunityItem[]
  erpOrderSyncs        ErpOrderSync[]
  erpOrderManualResolutions ErpOrderManualResolution[]
  erpOrderStatusHistory ErpOrderStatusHistory[]
  createdAt            DateTime               @default(now())
}

model OpportunityChangeLog {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id])
  field         String
  oldValue      String?
  newValue      String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
}

model TimelineEvent {
  id            String       @id @default(cuid())
  type          EventType
  description   String
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  ownerSellerId String
  ownerSeller   User         @relation(fields: [ownerSellerId], references: [id])
  createdAt     DateTime     @default(now())
}

model Activity {
  id              String       @id @default(cuid())
  type            ActivityType
  notes           String
  description     String?
  result          String?
  dueDate         DateTime
  date            DateTime?
  duration        Int?
  city            String?
  crop            String?
  areaEstimated   Float?
  product         String?
  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  done            Boolean      @default(false)
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  agendaEventId   String?
  agendaEvent     AgendaEvent? @relation(fields: [agendaEventId], references: [id], onDelete: SetNull)
  ownerSellerId   String
  ownerSeller     User         @relation(fields: [ownerSellerId], references: [id])
  createdAt       DateTime     @default(now())
}

model Goal {
  tenantId    String?
  tenant      Tenant?  @relation("TenantGoals", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String   @id @default(cuid())
  month       String
  targetValue Float
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sellerId, month])
  @@index([tenantId])
}

model ActivityKPI {
  tenantId    String?
  tenant      Tenant?  @relation("TenantActivityKpis", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String   @id @default(cuid())
  sellerId    String
  type        String
  month       String
  targetValue Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, month, type])
  @@index([tenantId])
}

model Sale {
  tenantId  String?
  tenant    Tenant?  @relation("TenantSales", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String   @id @default(cuid())
  date      DateTime
  value     Float
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model SellerTerritoryCity {
  tenantId  String?
  tenant    Tenant?  @relation("TenantTerritoryCities", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  state     String
  city      String
  ibgeCode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, state, city])
  @@index([sellerId])
  @@index([state, city])
  @@index([tenantId])
}

model AppConfig {
  tenantId  String?
  tenant    Tenant?  @relation("TenantAppConfigs", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model CultureCatalog {
  id                      String   @id @default(uuid())
  slug                    String   @unique
  label                   String
  category                String   @default("Outras")
  isActive                Boolean  @default(true)
  defaultKgHaMin          Float?
  defaultKgHaMax          Float?
  goalsJson               Json
  notes                   String?
  pmsDefault              Float?
  germinationDefault      Float?
  purityDefault           Float?
  populationTargetDefault Float?
  rowSpacingCmDefault     Float?
  tags                    String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([isActive])
}

model Product {
  tenantId            String?
  tenant              Tenant?           @relation("TenantProducts", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                  String            @id @default(cuid())
  erpProductCode      String
  erpProductClassCode String
  name                String
  className           String?
  unit                String?
  brand               String?
  groupName           String?
  isActive            Boolean           @default(true)
  isSuspended         Boolean           @default(false)
  stockQuantity       Float?
  minPrice            Float?
  defaultPrice        Float?
  rawErpPayload       Json?
  prices              ProductPrice[]
  opportunityItems    OpportunityItem[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([erpProductCode, erpProductClassCode])
  @@index([name])
  @@index([tenantId])
}

model ProductPrice {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  erpPriceId String?
  branchCode String?
  validFrom  DateTime?
  price      Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([productId])
  @@index([branchCode])
}

model OpportunityItem {
  id                  String                      @id @default(cuid())
  opportunityId       String
  opportunity         Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber          Int
  erpProductCode      String
  erpProductClassCode String
  productNameSnapshot String
  unit                String?
  quantity            Float
  unitPrice           Float
  discountType        OpportunityItemDiscountType @default(value)
  discountValue       Float                       @default(0)
  grossTotal          Float
  discountTotal       Float
  netTotal            Float
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([opportunityId, lineNumber])
  @@index([opportunityId])
  @@index([productId])
}

enum ErpOrderSyncStatus {
  pending
  sent
  error
}

enum ErpOrderFulfillmentStatus {
  pendente
  faturado
  parcial
  cancelado
  entregue
}

enum ErpOperationalOrderStatus {
  DIGITADO
  ACEITO
  EXPEDINDO
  FATURAR
  PARCIAL
  FINALIZADO
  CANCELADO
  SUSPENSO
  UNKNOWN
}

enum ErpRequestAuthorizationStatus {
  NONE_OR_NOT_APPLICABLE
  PARTIALLY_AUTHORIZED
  NONE_AUTHORIZED
  ALL_AUTHORIZED
  UNKNOWN
}

enum ErpOrderManualResolutionCategory {
  manual_verified_not_found
}

enum ErpOrderManualResolutionTerminalState {
  manually_resolved_not_found
}

model ErpOrderSync {
  tenantId           String
  tenant             Tenant                       @relation("TenantErpOrders", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                 String                     @id @default(cuid())
  opportunityId      String
  opportunity        Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             User                       @relation(fields: [sellerId], references: [id])
  pedidoIdImportacao String                     @unique
  numPedido          String?
  erpOrderNumber     String?
  erpOrderId         String?
  operationalStatusRaw String?
  operationalOrderStatus ErpOperationalOrderStatus @default(UNKNOWN)
  requestAuthorizationStatus ErpRequestAuthorizationStatus @default(UNKNOWN)
  status             ErpOrderSyncStatus         @default(pending)
  orderStatus        ErpOrderFulfillmentStatus?
  payloadSent        Json
  erpResponse        Json?
  syncErrors         Json?
  lastStatusPayload  Json?
  sentAt             DateTime?
  statusSyncedAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  supersedesErpOrderSyncId String?
  supersedesErpOrderSync   ErpOrderSync?         @relation("ErpOrderRetryChain", fields: [supersedesErpOrderSyncId], references: [id], onDelete: Restrict)
  retryAttempts            ErpOrderSync[]        @relation("ErpOrderRetryChain")
  manualResolution         ErpOrderManualResolution?
  statusHistory            ErpOrderStatusHistory[]

  @@index([opportunityId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, sellerId, createdAt])
  @@index([status])
  @@index([orderStatus])
  @@index([numPedido])
  @@index([supersedesErpOrderSyncId])
}

model ErpOrderStatusHistory {
  id                   String                    @id @default(cuid())
  erpOrderSyncId       String
  erpOrderSync         ErpOrderSync              @relation(fields: [erpOrderSyncId], references: [id], onDelete: Cascade)
  opportunityId        String
  opportunity          Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  syncStatus           ErpOrderSyncStatus
  orderStatus          ErpOrderFulfillmentStatus?
  operationalStatusRaw String?
  source               String
  errorMessage         String?
  occurredAt           DateTime                  @default(now())

  @@index([erpOrderSyncId, occurredAt])
  @@index([opportunityId, occurredAt])
}

model ErpOrderManualResolution {
  id                         String       @id @default(cuid())
  erpOrderSyncId             String       @unique
  erpOrderSync               ErpOrderSync @relation(fields: [erpOrderSyncId], references: [id], onDelete: Restrict)
  opportunityId              String
  opportunity                Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  resolvedById               String
  resolvedBy                 User         @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedRole               Role
  category                   ErpOrderManualResolutionCategory
  terminalState              ErpOrderManualResolutionTerminalState
  justification              String
  originalPedidoIdImportacao String
  originalCorrelationId      String
  statusCheckedAt            DateTime
  statusCheckCorrelationId   String
  createdAt                  DateTime     @default(now())

  @@index([opportunityId, createdAt])
  @@index([resolvedById, createdAt])
}

enum ErpSyncRunStatus {
  running
  success
  error
  skipped
}

enum ErpSyncTrigger {
  manual
  scheduler
}

model ErpSyncRun {
  tenantId      String?
  tenant        Tenant?          @relation("TenantErpSyncRuns", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id            String           @id @default(cuid())
  scope         String
  trigger       ErpSyncTrigger   @default(manual)
  status        ErpSyncRunStatus @default(running)
  sellerId      String?
  sellerName    String?
  authMode      String           @default("global")
  correlationId String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  syncedCount   Int              @default(0)
  metrics       Json?
  errors        Json?
  errorMessage  String?
  createdAt     DateTime         @default(now())

  @@index([scope, startedAt])
  @@index([sellerId, startedAt])
  @@index([authMode, startedAt])
  @@index([status, startedAt])
  @@index([tenantId])
}

model ErpSyncLock {
  tenantId    String?
  tenant      Tenant?  @relation("TenantErpSyncLocks", fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scope       String   @id
  runId       String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
  @@index([tenantId])
}

enum CommunicationChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK_MESSENGER
  EMAIL
  SMS
  RCS
  TELEGRAM
  WEBSITE_CHAT
  OTHER
}

enum CommunicationProviderType {
  META_WHATSAPP_CLOUD
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  STICKER
  REACTION
  INTERACTIVE
  TEMPLATE
  UNKNOWN
}

enum CommunicationMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CommunicationConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
  BLOCKED
}

enum CommunicationWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
}

model CommunicationIntegrationAccount {
  id                  String                      @id @default(cuid())
  tenantId            String                      @db.VarChar(64)
  provider            CommunicationProviderType
  channel             CommunicationChannelType
  externalAccountId   String                      @db.VarChar(128)
  displayName         String?                     @db.VarChar(120)
  status              String                      @default("pending_configuration") @db.VarChar(40)
  enabled             Boolean                     @default(true)
  configurationState  String                      @default("incomplete") @db.VarChar(40)
  credentialReference String?                     @db.VarChar(160)
  conversations       CommunicationConversation[]
  messages            CommunicationMessage[]
  webhookEvents       CommunicationWebhookEvent[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([tenantId, provider, channel, externalAccountId])
  @@index([provider, channel, externalAccountId])
  @@index([tenantId, enabled])
}

model CommunicationConversation {
  id                      String                           @id @default(cuid())
  channel                 CommunicationChannelType
  provider                CommunicationProviderType
  externalConversationKey String
  externalAccountId       String
  tenantId                String?                          @db.VarChar(64)
  integrationAccountId    String?
  integrationAccount      CommunicationIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contactPhoneHash        String?                          @db.VarChar(64)
  clientId                String?
  client                  Client?                          @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedSellerId        String?
  assignedSeller          User?                            @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contactNormalized       String?                          @db.VarChar(32)
  contactDisplay          String?                          @db.VarChar(64)
  contactName             String?                          @db.VarChar(120)
  status                  CommunicationConversationStatus  @default(OPEN)
  lastMessageAt           DateTime?
  lastInboundAt           DateTime?
  lastOutboundAt          DateTime?
  unreadCount             Int                              @default(0)
  previewSanitized        String?                          @db.VarChar(240)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  messages                CommunicationMessage[]

  @@unique([provider, externalAccountId, externalConversationKey])
  @@index([integrationAccountId])
  @@index([tenantId, contactPhoneHash])
  @@index([tenantId])
  @@index([clientId])
  @@index([assignedSellerId])
  @@index([contactNormalized])
  @@index([status])
  @@index([lastMessageAt])
}

model CommunicationMessage {
  id                       String                           @id @default(cuid())
  conversationId           String
  conversation             CommunicationConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  channel                  CommunicationChannelType
  provider                 CommunicationProviderType
  externalMessageId        String
  externalAccountId        String
  tenantId                 String?                          @db.VarChar(64)
  integrationAccountId     String?
  integrationAccount       CommunicationIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contactPhoneHash         String?                          @db.VarChar(64)
  direction                CommunicationDirection
  type                     CommunicationMessageType
  textContent              String?
  mediaMetadata            Json?
  providerTimestamp        DateTime?
  replyToExternalMessageId String?
  status                   CommunicationMessageStatus       @default(RECEIVED)
  errorSanitized           String?                          @db.VarChar(240)
  metadata                 Json?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@unique([provider, externalAccountId, externalMessageId])
  @@index([integrationAccountId])
  @@index([tenantId, contactPhoneHash])
  @@index([conversationId])
  @@index([tenantId])
  @@index([providerTimestamp])
  @@index([status])
}

model CommunicationWebhookEvent {
  id                   String                           @id @default(cuid())
  channel              CommunicationChannelType
  provider             CommunicationProviderType
  externalEventKey     String
  externalAccountId    String
  tenantId             String?                          @db.VarChar(64)
  integrationAccountId String?
  integrationAccount   CommunicationIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  eventType            String                           @db.VarChar(64)
  payloadHash          String                           @db.VarChar(64)
  status               CommunicationWebhookStatus       @default(RECEIVED)
  attempts             Int                              @default(0)
  processedAt          DateTime?
  errorSanitized       String?                          @db.VarChar(240)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  @@unique([provider, externalAccountId, externalEventKey])
  @@index([integrationAccountId])
  @@index([tenantId])
  @@index([status, createdAt])
  @@index([payloadHash])
}
